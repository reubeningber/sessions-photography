# Cloudinary cloud name used to build image delivery URLs (not secret, but kept
# configurable so staging/prod or a future rename doesn't require code changes).
PUBLIC_CLOUDINARY_CLOUD_NAME=dt3vcpkj6

# Server-only Cloudinary credentials — needed to run `npm run upload` (see
# scripts/upload-to-cloudinary.mjs). Never prefix these with PUBLIC_ and never
# commit real values; get them from the Cloudinary console (Dashboard > API Keys).
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google Analytics 4 Measurement ID. Leave unset in local dev to avoid
# polluting analytics with test traffic.
PUBLIC_GA_MEASUREMENT_ID=G-4QBSMG1XN3
