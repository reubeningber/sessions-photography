---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Gallery from '../../components/Gallery.astro';
import Sessions from '../../components/Sessions.astro';
import About from '../../components/About.astro';
import Testimonials from '../../components/Testimonials.astro';
import Contact from '../../components/Contact.astro';

const title = 'Family Photographer in Queens, Brooklyn & Manhattan | Photo Sessions with Reuben Ingber';
const description =
  'Warm, true-to-life family photography around Queens, Brooklyn, and Manhattan. Real days, kept well — book a session with Reuben.';
