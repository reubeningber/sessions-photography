---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Thanks for reaching out | Photo Sessions with Reuben Ingber';
const description = 'Your inquiry has been received — Reuben will follow up shortly.';
---

<BaseLayout title={title} description={description}>
  <section class="section thank-you">
    <div class="container thank-you__inner">
      <p class="eyebrow">Thank You</p>
      <h1>Got it — talk soon.</h1>
      <p>
        Thanks for reaching out. I'll get back to you within a day or two to lock in a
        date.
      </p>
      <a href="/preview/#work" class="link-ghost">&larr; Back to the site</a>
    </div>
  </section>
</BaseLayout>

<style>
  .thank-you {
    min-height: 50vh;
    display: flex;
    align-items: center;
  }

  .thank-you__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 32rem;
  }
</style>
