---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';

const title = 'Family Photographer in Queens, Brooklyn & Manhattan | Photo Sessions with Reuben';
const description =
  'Warm, true-to-life family photography around Queens, Brooklyn, and Manhattan. Real days, kept well — book a session with Reuben.';
---

<BaseLayout title={title} description={description}>
  <Hero />
  <Gallery />
</BaseLayout>
