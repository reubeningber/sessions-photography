---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page Not Found | Photo Sessions with Reuben Ingber';
const description = 'The page you were looking for could not be found.';
---

<BaseLayout title={title} description={description}>
  <section class="section not-found">
    <div class="container not-found__inner">
      <p class="eyebrow">404</p>
      <h1>Page not found.</h1>
      <p>The page you're looking for doesn't exist, or moved.</p>
      <a href="/" class="link-ghost">&larr; Back to the homepage</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 50vh;
    display: flex;
    align-items: center;
  }

  .not-found__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 32rem;
  }
</style>
