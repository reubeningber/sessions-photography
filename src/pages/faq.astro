---
import BaseLayout from '../layouts/BaseLayout.astro';
import Accordion from '../components/Accordion.astro';
import { faqs } from '../data/faqs';
import { BASE_PATH } from '../consts';

const title = 'FAQ | Photo Sessions with Reuben Ingber';
const description =
  'Answers to common questions about booking, session length, weather, and turnaround time.';

// Reuses the same faqs data the visible Accordion renders, so the rich
// result Google may show always matches this page's real content — just
// stripped of the answer HTML (schema.org's `text` wants plain text, not
// the <p>/<ul>/<strong> markup Accordion renders via set:html).
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(),
    },
  })),
};
---

<BaseLayout title={title} description={description}>
  <section class="section faq">
    <div class="container faq__inner">
      <p class="eyebrow">FAQ</p>
      <h1>Questions, answered.</h1>
      <p class="faq__intro">
        Can't find what you're looking for? <a href={`${BASE_PATH}#contact`}>Reach out</a> and I'll
        get back to you directly.
      </p>

      <Accordion items={faqs} />

      <a href={`${BASE_PATH}#contact`} class="btn btn-primary faq__cta">Check availability</a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>

<style>
  .faq__inner {
    max-width: 42rem;
  }

  .faq__intro {
    color: var(--muted);
    margin-block: 0.75rem 2rem;
  }

  .faq__intro a {
    color: var(--sage-deep);
    text-decoration: underline;
  }

  .faq__cta {
    margin-block-start: 2.5rem;
  }
</style>
