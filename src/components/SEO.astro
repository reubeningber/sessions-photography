---
import { sessionTypes } from '../data/sessionTypes';

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative image URL. Defaults to the branded
   * logo/wordmark share card (public/images/og-share.png) — a static PNG
   * rather than a Cloudinary transform, so there's no format-negotiation
   * risk for crawlers that unfurl og:image/twitter:image without an
   * Accept header. */
  image?: string;
}

const { title, description, image } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const defaultOgImage = '/images/og-share.png';

const imageUrl = new URL(image ?? defaultOgImage, Astro.site).toString();

const prices = sessionTypes.map((session) => Number(session.price.replace(/[^0-9.]/g, '')));
const priceRange = `$${Math.min(...prices)}-$${Math.max(...prices)}`;

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Photo Sessions with Reuben Ingber',
  description:
    'Family photography sessions on location around the New York tri-state area.',
  url: 'https://sessions.reubeningber.com',
  email: 'sessions@reubeningber.com',
  areaServed: ['New York, NY', 'New Jersey', 'Connecticut'],
  priceRange,
  image: imageUrl,
  sameAs: ['https://www.instagram.com/photosessionswithreuben'],
  founder: {
    '@type': 'Person',
    name: 'Reuben Ingber',
    url: 'https://reubeningber.com',
    sameAs: [
      'https://www.instagram.com/reubeningber',
      'https://www.instagram.com/reuben_in_color',
    ],
  },
  makesOffer: sessionTypes.map((session) => ({
    '@type': 'Offer',
    name: session.name,
    price: session.price.replace(/[^0-9.]/g, ''),
    priceCurrency: 'USD',
    description: `${session.duration} — ${session.features.join(', ')}`,
  })),
};
---

<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content="Photo Sessions with Reuben Ingber" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
