---
import { cloudinaryUrl } from '../lib/cloudinary';
import { sessionTypes } from '../data/sessionTypes';

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative image URL. Defaults to a real photo (not a
   * placeholder graphic) sized for social-share previews — see the
   * `defaultOgImage` note below for why it forces a concrete format. */
  image?: string;
}

const { title, description, image } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

// f_jpg (not the usual f_auto) because crawlers that unfurl og:image/
// twitter:image links typically don't send an Accept header, so format
// negotiation can't happen — an avif/webp response can fail to render in
// the share preview even though it's fine for a real browser tab.
const defaultOgImage = cloudinaryUrl('autumn-couple-portrait', {
  width: 1200,
  aspectRatio: 1200 / 630,
  crop: 'fill',
  gravity: 'faces',
  format: 'jpg',
});

const imageUrl = new URL(image ?? defaultOgImage, Astro.site).toString();

const prices = sessionTypes.map((session) => Number(session.price.replace(/[^0-9.]/g, '')));
const priceRange = `$${Math.min(...prices)}-$${Math.max(...prices)}`;

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Photo Sessions with Reuben Ingber',
  description:
    'Family photography sessions on location around Queens, Brooklyn, and Manhattan, NYC.',
  url: 'https://sessions.reubeningber.com',
  email: 'sessions@reubeningber.com',
  areaServed: ['Queens, NY', 'Brooklyn, NY', 'Manhattan, NY'],
  priceRange,
  image: defaultOgImage,
  sameAs: ['https://www.instagram.com/photosessionswithreuben'],
  makesOffer: sessionTypes.map((session) => ({
    '@type': 'Offer',
    name: session.name,
    price: session.price.replace(/[^0-9.]/g, ''),
    priceCurrency: 'USD',
    description: `${session.duration} — ${session.features.join(', ')}`,
  })),
};
---

<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content="Photo Sessions with Reuben Ingber" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
