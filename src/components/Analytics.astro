---
// Only loaded for production builds, so local `npm run dev` sessions and
// preview builds don't pollute real analytics with test traffic.
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const shouldLoad = import.meta.env.PROD && Boolean(measurementId);
---

{
  shouldLoad && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`} />
      <script is:inline define:vars={{ measurementId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', measurementId);
      </script>
    </>
  )
}
