---
import CloudinaryImage from './CloudinaryImage.astro';
---

<section class="section" id="about">
  <div class="container about">
    <CloudinaryImage
      publicId="v1761245976/web_assets/reuben_ingber_october_2025"
      placeholder="/images/placeholders/about.svg"
      alt="Reuben, a family photographer based in Rego Park, Queens"
      aspectRatio={4 / 5}
      sizes="(min-width: 760px) 40vw, 100vw"
      class="about__image"
    />

    <div class="about__copy">
      <p class="eyebrow">About</p>
      <h2>Hi, I'm Reuben.</h2>
      <p>
        I'm a dad of two in Rego Park who's spent the last few years chasing good
        light around this city — on runs, on the subway, in the backyard, wherever
        it shows up.
      </p>
      <p>
        I shoot warm and candid, closer to how a moment actually felt than how it was
        staged. If your kids won't sit still for a posed shot, that's usually where
        the best frame is anyway.
      </p>
      <p>
        Sessions are relaxed, kid-paced, and built around your neighborhood or a spot
        you already love.
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: center;
  }

  /* :global() because this class targets the <img> rendered inside the
     CloudinaryImage child component — Astro only auto-scopes elements
     written directly in this file's own template. */
  :global(.about__image) {
    width: min(100%, 22rem);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .about__copy {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 40rem;
  }

  .about__copy h2 {
    margin-block-end: 0.25rem;
  }

  @media (min-width: 760px) {
    .about {
      flex-direction: row;
      align-items: flex-start;
    }

    :global(.about__image) {
      flex: 0 0 auto;
      width: min(36%, 22rem);
    }
  }
</style>
