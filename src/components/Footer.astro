---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="wordmark">Photo Sessions <em>with Reuben</em></p>
    <p class="site-footer__copy">&copy; {year} Photo Sessions with Reuben</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .site-footer .wordmark {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--ink);
  }

  .site-footer .wordmark em {
    color: var(--sage);
  }

  @media (min-width: 640px) {
    .site-footer__inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: initial;
    }
  }
</style>
