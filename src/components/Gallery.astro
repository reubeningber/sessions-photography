---
import CloudinaryImage from './CloudinaryImage.astro';
import { cloudinaryUrl } from '../lib/cloudinary';
import { galleryImages } from '../data/gallery';

// Full-size (uncropped, capped at 2000px) source for the lightbox — 'limit'
// scales down to fit without upscaling or cropping, unlike the grid tiles'
// fixed-aspect 'fill' crop.
const lightboxItems = galleryImages.map((item) => ({
  src: item.publicId ? cloudinaryUrl(item.publicId, { width: 2000, crop: 'limit' }) : item.placeholder,
  alt: item.alt,
  caption: item.caption,
}));
---

<section class="section" id="work">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">Selected Work</p>
      <h2>Recent sessions</h2>
    </div>

    <ul class="gallery-grid">
      {galleryImages.map((item, index) => {
        const isLandscape = item.orientation === 'landscape';
        const sizes = isLandscape
          ? '(min-width: 1024px) 66vw, 100vw'
          : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw';

        return (
          <li
            class:list={['gallery-item reveal', isLandscape && 'gallery-item--landscape']}
            style={`--tile-ar: ${item.aspectRatio}`}
          >
            <figure>
              <button
                type="button"
                class="gallery-item__trigger"
                data-lightbox-index={index}
                aria-label={`Open larger photo: ${item.caption}`}
              >
                <CloudinaryImage
                  publicId={item.publicId}
                  placeholder={item.placeholder}
                  alt={item.alt}
                  aspectRatio={item.aspectRatio}
                  gravity={item.gravity}
                  sizes={sizes}
                  class="gallery-item__image"
                />
                <span class="gallery-item__expand" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 3H3v6M15 3h6v6M21 15v6h-6M3 15v6h6" />
                  </svg>
                </span>
              </button>
            </figure>
          </li>
        );
      })}
    </ul>
  </div>

  <div class="lightbox" id="gallery-lightbox" hidden>
    <button type="button" class="lightbox__backdrop" aria-label="Close photo viewer"></button>
    <div class="lightbox__dialog" role="dialog" aria-modal="true" aria-label="Photo viewer">
      <button type="button" class="lightbox__control lightbox__close" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
      <button type="button" class="lightbox__control lightbox__nav lightbox__nav--prev" aria-label="Previous photo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6" />
        </svg>
      </button>
      <figure class="lightbox__figure">
        <img class="lightbox__image" src="" alt="" />
        <figcaption class="lightbox__caption"></figcaption>
      </figure>
      <button type="button" class="lightbox__control lightbox__nav lightbox__nav--next" aria-label="Next photo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>
    </div>
  </div>

  <script type="application/json" id="gallery-lightbox-data" is:inline set:html={JSON.stringify(lightboxItems)} />
</section>

<style>
  .gallery-grid {
    /* Lets the landscape-tile height rule below measure this element's own
       rendered width via cqw, so it can match the portrait tiles' height
       exactly regardless of viewport size or content-max-width capping. */
    container-type: inline-size;
    --gallery-gap: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-flow: dense;
    gap: var(--gallery-gap);
  }

  .gallery-item__trigger {
    all: unset;
    display: block;
    width: 100%;
    position: relative;
    cursor: pointer;
  }

  /* :global() because these classes target elements rendered inside the
     CloudinaryImage child component — Astro only auto-scopes elements
     written directly in this file's own template. */
  :global(.gallery-item__image) {
    width: 100%;
    aspect-ratio: var(--tile-ar, 4 / 5);
    object-fit: cover;
    border-radius: var(--radius-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .gallery-item:hover :global(.gallery-item__image) {
    box-shadow: var(--shadow-lift);
  }

  .gallery-item__expand {
    position: absolute;
    inset-block-end: 0.75rem;
    inset-inline-end: 0.75rem;
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: rgb(43 42 38 / 0.55);
    color: var(--paper);
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  .gallery-item__expand svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .gallery-item__trigger:hover .gallery-item__expand,
  .gallery-item__trigger:focus-visible .gallery-item__expand {
    opacity: 1;
    transform: scale(1);
  }

  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* A landscape photo spans both columns instead of being force-cropped
       into a portrait-shaped slot. Its height is pinned (via cqw, not its
       own aspect-ratio) to match the portrait tiles' height in the same
       row — plain aspect-ratio can't do this because a 2-column span's
       width includes a gap the portrait column doesn't have. */
    .gallery-item--landscape {
      grid-column: span 2;
    }

    .gallery-item--landscape :global(.gallery-item__image) {
      aspect-ratio: auto;
      height: calc((100cqw - var(--gallery-gap)) / 2 * 5 / 4);
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .gallery-item--landscape :global(.gallery-item__image) {
      height: calc((100cqw - 2 * var(--gallery-gap)) / 3 * 5 / 4);
    }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__backdrop {
    all: unset;
    position: absolute;
    inset: 0;
    background-color: rgb(43 42 38 / 0.92);
    cursor: pointer;
  }

  .lightbox__dialog {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 3vw, 2rem);
    max-width: 100%;
  }

  .lightbox__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: min(90vw, 72rem);
  }

  .lightbox__image {
    max-width: min(90vw, 72rem);
    max-height: 80vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lift);
    opacity: 1;
    transition: opacity 0.15s ease;
  }

  /* Applied while the next photo is downloading, so the previous one never
     lingers or flashes on screen mid-swap — see the render() script below. */
  .lightbox__image.is-loading {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox__image {
      transition: none;
    }
  }

  .lightbox__caption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--paper);
    opacity: 0.85;
  }

  .lightbox__control {
    all: unset;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border-radius: 50%;
    background-color: rgb(251 250 247 / 0.12);
    color: var(--paper);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .lightbox__control:hover,
  .lightbox__control:focus-visible {
    background-color: rgb(251 250 247 / 0.24);
  }

  .lightbox__control svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .lightbox__close {
    position: absolute;
    inset-block-start: -3.5rem;
    inset-inline-end: 0;
  }

  @media (min-width: 640px) {
    .lightbox__close {
      inset-block-start: 0;
      inset-inline-end: -3.5rem;
    }
  }

  :global(body.lightbox-open) {
    overflow: hidden;
  }
</style>

<script>
  const revealItems = document.querySelectorAll('.reveal');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
    );

    revealItems.forEach((item) => observer.observe(item));
  }

  const dataEl = document.getElementById('gallery-lightbox-data');
  const items = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImage = lightbox?.querySelector('.lightbox__image');
  const lightboxCaption = lightbox?.querySelector('.lightbox__caption');
  const closeBtn = lightbox?.querySelector('.lightbox__close');
  const backdrop = lightbox?.querySelector('.lightbox__backdrop');
  const prevBtn = lightbox?.querySelector('.lightbox__nav--prev');
  const nextBtn = lightbox?.querySelector('.lightbox__nav--next');
  const triggers = document.querySelectorAll('.gallery-item__trigger');

  let currentIndex = 0;
  let lastFocused: Element | null = null;
  // Tracks which full-size photos have already been fetched, so hovering a
  // tile (or opening/navigating the lightbox) only ever downloads each one
  // once.
  const preloaded = new Set<number>();

  function preload(index: number) {
    const item = items[index];
    if (!item || preloaded.has(index)) return;
    preloaded.add(index);
    new Image().src = item.src;
  }

  function render() {
    const item = items[currentIndex];
    if (!item || !(lightboxImage instanceof HTMLImageElement)) return;

    if (lightboxCaption) lightboxCaption.textContent = item.caption;
    preloaded.add(currentIndex);

    // Swap the <img> only once the new photo has actually loaded, so the
    // previous photo never lingers on screen (or flashes) while the next
    // one downloads — it fades out, swaps, then fades back in instead.
    const next = new Image();
    const swap = () => {
      lightboxImage.src = item.src;
      lightboxImage.alt = item.alt;
      requestAnimationFrame(() => lightboxImage.classList.remove('is-loading'));
    };
    next.addEventListener('load', swap);
    next.addEventListener('error', swap);
    lightboxImage.classList.add('is-loading');
    next.src = item.src;

    // Get a head start on whichever photo prev/next would show next.
    preload((currentIndex + 1) % items.length);
    preload((currentIndex - 1 + items.length) % items.length);
  }

  function show(delta: number) {
    if (items.length === 0) return;
    currentIndex = (currentIndex + delta + items.length) % items.length;
    render();
  }

  function onKeydown(event: KeyboardEvent) {
    if (event.key === 'Escape') closeLightbox();
    else if (event.key === 'ArrowRight') show(1);
    else if (event.key === 'ArrowLeft') show(-1);
  }

  function openLightbox(index: number) {
    if (!lightbox || !items[index]) return;
    currentIndex = index;
    render();
    lastFocused = document.activeElement;
    lightbox.hidden = false;
    document.body.classList.add('lightbox-open');
    document.addEventListener('keydown', onKeydown);
    if (closeBtn instanceof HTMLElement) closeBtn.focus();
  }

  function closeLightbox() {
    if (!lightbox || lightbox.hidden) return;
    lightbox.hidden = true;
    document.body.classList.remove('lightbox-open');
    document.removeEventListener('keydown', onKeydown);
    if (lastFocused instanceof HTMLElement) lastFocused.focus();
  }

  triggers.forEach((trigger) => {
    const index = Number(trigger.getAttribute('data-lightbox-index'));
    if (Number.isNaN(index)) return;

    trigger.addEventListener('click', () => openLightbox(index));
    // A hover or keyboard focus is a strong signal the photo is about to be
    // opened, so get the full-size version downloading ahead of the click.
    trigger.addEventListener('mouseenter', () => preload(index));
    trigger.addEventListener('focus', () => preload(index));
  });

  closeBtn?.addEventListener('click', closeLightbox);
  backdrop?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', () => show(-1));
  nextBtn?.addEventListener('click', () => show(1));
</script>
