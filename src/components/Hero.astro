---
// The hero shows a rotating set of placeholder tiles until real session
// photos are ready to swap in. Once Cloudinary photos exist, replace each
// `placeholder` below with a `publicId` (see CloudinaryImage.astro) and
// this same crossfade gallery will carry real photos instead.
const slides = [
  { placeholder: '/images/placeholders/hero.svg' },
  { placeholder: '/images/placeholders/portrait-1.svg' },
  { placeholder: '/images/placeholders/portrait-2.svg' },
  { placeholder: '/images/placeholders/portrait-3.svg' },
  { placeholder: '/images/placeholders/portrait-4.svg' },
];

// Total time (seconds) for one full loop through every slide.
const slotSeconds = 4;
const cycleSeconds = slides.length * slotSeconds;
---

<section class="hero">
  <div class="container hero__inner">
    <p class="eyebrow">Family Photography · Queens &amp; NYC</p>
    <h1>Real days, <em>kept well.</em></h1>
    <p class="hero__subhead">
      Warm, true-to-life family photography around Queens, Brooklyn, and Manhattan —
      bodega runs, stoop light, and Sunday mornings, the way you'll actually want to
      remember them.
    </p>
    <div class="hero__actions">
      <a href="#contact" class="btn btn-primary">Check availability</a>
      <a href="#work" class="link-ghost">See the work &rarr;</a>
    </div>
  </div>

  <div
    class="hero__gallery"
    role="img"
    aria-label="Rotating preview of family photography sessions — placeholder imagery, real photos coming soon"
  >
    {slides.map((slide, i) => (
      <img
        src={slide.placeholder}
        alt=""
        aria-hidden="true"
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
        decoding="async"
        class="hero__slide"
        style={`animation-delay: -${i * slotSeconds}s;`}
      />
    ))}
  </div>
</section>

<style define:vars={{ heroCycle: `${cycleSeconds}s` }}>
  .hero {
    padding-block-start: clamp(3rem, 6vw, 6rem);
    padding-block-end: var(--section-padding-block);
    border-bottom: 1px solid var(--line);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 42rem;
    margin-block-end: clamp(2rem, 5vw, 3.5rem);
  }

  .hero h1 {
    margin-block-start: 0.5rem;
  }

  .hero h1 em {
    color: var(--sage);
  }

  .hero__subhead {
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
    margin-block-start: 0.5rem;
  }

  /* Full-bleed: break out of .container so the gallery runs edge-to-edge
     and reads as a bigger, more prominent hero than a boxed static image. */
  .hero__gallery {
    position: relative;
    overflow: hidden;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    aspect-ratio: 4 / 3;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: hero-fade var(--heroCycle) infinite;
  }

  /* Each slide shares one keyframe loop; a negative animation-delay
     (set inline per slide) staggers where in the loop it starts, so the
     slides advance in sequence with no JS required. */
  @keyframes hero-fade {
    0% {
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    18% {
      opacity: 1;
    }
    24% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      animation: none;
      opacity: 0;
    }

    .hero__slide:first-child {
      opacity: 1;
    }
  }

  @media (min-width: 760px) {
    .hero__gallery {
      aspect-ratio: 21 / 9;
    }
  }
</style>
