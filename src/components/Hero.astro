---
import CloudinaryImage from './CloudinaryImage.astro';

// The hero shows a rotating crossfade of real session photos. Each slide is
// a Cloudinary publicId (see CloudinaryImage.astro), cropped to a shared
// wide 4:3 ratio with face-aware gravity so every photo reads consistently
// regardless of its original orientation. The gallery box is boxed (not
// full-bleed) — capped narrower than the page content and centered.
const slideAspectRatio = 4 / 3;
const slideGravity = 'faces';

const slides = [
  { publicId: 'baby-bed-crawl', alt: 'Baby girl in a yellow outfit smiling while crawling across a bed' },
  { publicId: 'heart-hands-mom', alt: 'Boy making a heart shape with his hands as his mom smiles beside him' },
  { publicId: 'fence-peek', alt: 'Toddler girl peeking up through a wooden fence rail, smiling' },
  { publicId: 'swing-sunglasses', alt: 'Boy in red sunglasses swinging at the playground' },
  { publicId: 'autumn-couple-portrait', alt: 'Couple smiling together under a canopy of deep autumn leaves' },
  { publicId: 'dad-kids-cheek-kisses', alt: 'Father getting cheek kisses from his two kids under the trees' },
  { publicId: 'family-of-four-stoop', alt: 'Family of four smiling together on a brownstone stoop railing' },
  { publicId: 'lakeside-portrait', alt: 'Young girl striking a playful pose, hands on hips, beside a park pond' },
];

// Total time (seconds) for one full loop through every slide.
const slotSeconds = 4;
const cycleSeconds = slides.length * slotSeconds;
---

<section class="hero">
  <div class="container hero__inner">
    <p class="eyebrow">Family Photography · Queens &amp; NYC</p>
    <h1>Real days, <em>kept well.</em></h1>
    <p class="hero__subhead">
      Warm, true-to-life family photography around Queens, Brooklyn, and Manhattan —
      bodega runs, stoop light, and Sunday mornings, the way you'll actually want to
      remember them.
    </p>
    <div class="hero__actions">
      <a href="#contact" class="btn btn-primary">Check availability</a>
      <a href="#work" class="link-ghost">See the work &rarr;</a>
    </div>
  </div>

  <div class="container">
    <div
      class="hero__gallery"
      role="img"
      aria-label="Rotating preview of recent family photography sessions around Queens and NYC"
    >
      {slides.map((slide, i) => (
        <div
          class="hero__slide"
          aria-hidden="true"
          style={`animation-delay: -${i * slotSeconds}s;`}
        >
          <CloudinaryImage
            publicId={slide.publicId}
            placeholder="/images/placeholders/hero.svg"
            alt=""
            aspectRatio={slideAspectRatio}
            gravity={slideGravity}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            class="hero__slide-img"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style define:vars={{ heroCycle: `${cycleSeconds}s` }}>
  .hero {
    padding-block-start: clamp(3rem, 6vw, 6rem);
    padding-block-end: var(--section-padding-block);
    border-bottom: 1px solid var(--line);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 42rem;
    margin-block-end: clamp(2rem, 5vw, 3.5rem);
  }

  .hero h1 {
    margin-block-start: 0.5rem;
  }

  .hero h1 em {
    color: var(--sage);
  }

  .hero__subhead {
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
    margin-block-start: 0.5rem;
  }

  /* Boxed, not full-bleed: sits in its own .container (same max-width and
     padding-inline as the Recent sessions grid below), wide 4:3 crop. */
  .hero__gallery {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 4 / 3;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    animation: hero-fade var(--heroCycle) infinite;
  }

  .hero__slide-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Each slide shares one keyframe loop; a negative animation-delay
     (set inline per slide) staggers where in the loop it starts, so the
     slides advance in sequence with no JS required. */
  @keyframes hero-fade {
    0% {
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    18% {
      opacity: 1;
    }
    24% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      animation: none;
      opacity: 0;
    }

    .hero__slide:first-child {
      opacity: 1;
    }
  }

</style>
