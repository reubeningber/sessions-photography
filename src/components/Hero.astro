---
import CloudinaryImage from './CloudinaryImage.astro';
---

<section class="hero">
  <div class="container hero__inner">
    <p class="eyebrow">Family Photography · Queens &amp; NYC</p>
    <h1>Real days, <em>kept well.</em></h1>
    <p class="hero__subhead">
      Warm, true-to-life family photography around Queens, Brooklyn, and Manhattan —
      bodega runs, stoop light, and Sunday mornings, the way you'll actually want to
      remember them.
    </p>
    <div class="hero__actions">
      <a href="#contact" class="btn btn-primary">Check availability</a>
      <a href="#work" class="link-ghost">See the work &rarr;</a>
    </div>
  </div>

  <div class="container">
    <CloudinaryImage
      publicId={null}
      placeholder="/images/placeholders/hero.svg"
      alt="Family walking together on a Queens sidewalk in late-afternoon light"
      aspectRatio={16 / 10}
      loading="eager"
      fetchpriority="high"
      class="hero__image"
    />
  </div>
</section>

<style>
  .hero {
    padding-block-start: clamp(3rem, 6vw, 6rem);
    padding-block-end: var(--section-padding-block);
    border-bottom: 1px solid var(--line);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 42rem;
    margin-block-end: clamp(2rem, 5vw, 3.5rem);
  }

  .hero h1 {
    margin-block-start: 0.5rem;
  }

  .hero h1 em {
    color: var(--sage);
  }

  .hero__subhead {
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
    margin-block-start: 0.5rem;
  }

  /* :global() because this class targets the <img> rendered inside the
     CloudinaryImage child component — Astro only auto-scopes elements
     written directly in this file's own template. */
  :global(.hero__image) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  @media (min-width: 760px) {
    :global(.hero__image) {
      aspect-ratio: 16 / 7;
    }
  }
</style>
